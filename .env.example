DATABASE_DRIVER=postgresql+psycopg
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=past_exam_user
DATABASE_PASSWORD=past_exam_password
DATABASE=past_exam

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

R2_URL=http://localhost:9000
R2_ACCESS_KEY=minioadmin
R2_ACCESS_TOKEN=minioadmin
R2_BUCKET_NAME=past-exam
R2_FILE_PATH=http://localhost:9000/past-exam

HASH_KEY=local-dev-secret-key-change-me
ORIGIN=http://localhost:5173
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_COOKIE_SECURE=false
AUTH_ALLOW_LEGACY_REFRESH_BEARER=false
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_GLOBAL_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS=false
# Required before proxy headers can be trusted. Include only the immediate
# reverse proxy and every intermediate proxy that appends X-Forwarded-For.
AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS=

GOOGLE_SERVICE_CLIENT_ID=placeholder
GOOGLE_SERVICE_SERCET=placeholder
